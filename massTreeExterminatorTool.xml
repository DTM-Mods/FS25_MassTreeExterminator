<?xml version="1.0" encoding="utf-8" standalone="no" ?>
<!-- Construction menu tile only (Shift-P > Landscaping > Mass Tree Exterminator): the brush marks an area and bulldozes
     the trees and bushes in it, nothing is ever placed. simplePlaceable is a vanilla placeable type; the base i3d is only
     the store item requirement and is never loaded by the brush. -->
<placeable type="simplePlaceable" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="../../../shared/xml/schema/placeable.xsd">
    <storeData>
        <name>$l10n_shopItem_massTreeExterminatorTool</name>
        <functions>
            <function>$l10n_function_massTreeExterminatorTool</function>
        </functions>
        <image>icon_massTreeExterminator.png</image>
        <price>0</price>
        <dailyUpkeep>0</dailyUpkeep>
        <lifetime>1000</lifetime>
        <rotation>0</rotation>
        <brand>NONE</brand>
        <species>PLACEABLE</species>
        <category>placeableMisc</category>
        <canBeSold>false</canBeSold>
        <showInStore>true</showInStore>
        <vertexBufferMemoryUsage>0</vertexBufferMemoryUsage>
        <indexBufferMemoryUsage>0</indexBufferMemoryUsage>
        <textureMemoryUsage>0</textureMemoryUsage>
        <instanceVertexBufferMemoryUsage>0</instanceVertexBufferMemoryUsage>
        <instanceIndexBufferMemoryUsage>0</instanceIndexBufferMemoryUsage>
        <brush>
            <type>FS25_MassTreeExterminator.massTreeExterminator</type>
            <category>landscaping</category>
            <tab>massTreeExterminator</tab>
        </brush>
    </storeData>

    <base>
        <filename>$data/shared/assets/constructionCursorSimple.i3d</filename>
    </base>
</placeable>
